[Unit]
Description=News Curator feed backend (knewsd)
Documentation=https://github.com/infidel/kde-news-curator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/knews-curator/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=KNEWS_ACCESS_LOG=1
# The OS owns this lifetime; the idle reaper (widget-spawned mode) must stay off here.
Environment=KNEWS_IDLE_EXIT=0
ExecStart=/usr/bin/python3 -m knewsd --port 8770 --host 127.0.0.1
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.local/share/knews-curator -%h/.cache/knews-curator
# Socket, lock and endpoint.json live in the per-session runtime dir (ProtectSystem=strict).
ReadWritePaths=-%t/knews-curator
# OPML exports go wherever the save dialog points (Downloads/Documents/Desktop).
ReadWritePaths=-%h/Downloads -%h/Documents -%h/Desktop

[Install]
WantedBy=default.target
